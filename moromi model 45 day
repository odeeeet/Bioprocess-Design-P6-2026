import logging
import numpy as np
import matplotlib.pyplot as plt
import cobra
from cobra import Reaction, Metabolite

logging.getLogger("cobra").setLevel(logging.ERROR)

# =====================================================================
# PARAMETERS
# =====================================================================
DT = 4.0
SALT_DAY   = 2.0      # salt added after 2-day koji (moromi 10% NaCl)
LAB_DAY    = 9.0      # T. halophilus inoculation (7 days after salt)
PEDIO_DAY  = 11.0     # P. acidilactici, 48 h after thal
YEAST_DAY  = 16.0     # Z. rouxii, 7 days after T. halophilus (both processes)

MOROMI_DAYS = 45.0                   # moromi length after T. halophilus inoculation
TOTAL_DAYS  = LAB_DAY + MOROMI_DAYS  # koji-clock end point

# W. versatilis: engineered process = added with T. halophilus (LAB_DAY);
# WT/standard = added with Z. rouxii, 7 days after T. halophilus
WV_STD_SET = {"base": YEAST_DAY}

INOC_THAL  = 0.100    # g/L DCW, T. halophilus (WT and engineered)
INOC_PEDIO = 0.025    # g/L DCW, P. acidilactici
INOC_YEAST = 0.015    # g/L DCW, Z. rouxii
INOC_WV    = 0.015    # g/L DCW, W. versatilis

T_START, T_END = 30.0, 25.0   # 30 C until Z. rouxii, then linear fall to 25 C at the end

G_GLC, G_ACID, G_GSH, G_PED = 0.18016, 0.09008, 0.3073, 4.624   # g/mmol
Q_THAL, Q_PEDIO = 0.64, 1.5      # glucose uptake caps at 30 C, mmol/gDW/h (carried over from first script)
# Pediocin: WT P. acidilactici ATCC 8042 is NOT a pediocin producer, so WT = 0.
# The engineered strain carries the heterologous pedABCD operon from strain PAC1.0 (plasmid-borne in PAC1.0).
# 1e-5 mmol pediocin per mmol glucose is ASSUMED to match the ~5 mg/L reported for producer strains in lab media;
# expression in ATCC 8042 has not been measured (depends on promoter and copy number).
FRAC_PED = {"wt": 0.0, "mut": 1e-5}
PED_LEADER_ATP = 72     # ATP for the ~18-aa leader peptide that is made and cleaved off (4 ATP/aa; ASSUMED, verify vs UniProt)
PED_EXPORT_ATP = 2      # ATP for export by the PedD ABC transporter (ASSUMED)

# pH gate on pediocin production.
PED_GATE_ON    = True   
PED_PH_FULL, PED_PH_OFF, PED_GATE_FLOOR = 5.0, 5.5, 0.05
ARG0_mM  = 5.0                   # ASSUMED free arginine
MW_CITR  = 175.19

# ---- Flavour scenarios  ----
# Literature scale (g/L) and assumed share made by T. halophilus
TYPICAL = dict(umami=10.0, kokumi=0.10)   # free glutamate ~10 g/L (low end of 8-39); sum of gamma-Glu peptides median ~0.1 g/L (0.02-0.62)
ATTR    = dict(umami=0.10, kokumi=0.10)   # ASSUMED: share attributable to T. halophilus
KOKUMI_FOLDS = {"low": 1.3, "base": 3.0, "high": 6.0}   # engineered/WT kokumi, from reported glutathione folds (1.3-6x)
UMAMI_FOLDS  = {"low": 1.5, "base": 3.0, "high": 3.5}   # engineered/WT umami
MULT_WT    = dict(umami=0.015, kokumi=0.008, meaty=0.005)
MEATY_FOLD = 2.0     # engineered/WT meaty, matches the ~2x VSC increase reported for CBL overexpression

# W. versatilis growth
MU_WV, KS_WV, XMAX_WV, DECAY_WV, Y_WV = 0.020, 2.5, 3.0, 0.0002, 0.28
WV_SALT = 0.7
WV_PH_STOP, WV_PH_FREE = 3.5, 4.8

# Smoky route: ferulic acid -> 4-VG -> 4-EG by W. versatilis biomass
FA0_mg, K_PAD, K_VPR = 30.0, 0.02, 0.01

T_AMYLASE   = (0.18, 0.09)
T_THAL_MU   = (1.0, 0.5)
T_PEDIO_MU  = (1.0, 0.3)
T_PED_DEGR  = (0.0015, 0.0045)

AMY_SALT = 0.35
AMY_PH_STOP, AMY_PH_FREE = 4.2, 5.5
PH_STOP_THAL, PH_STOP_PEDIO = 4.3, 4.2
PH_FREE = 5.2

PARAMS = {
    "wt": dict(ph_floor=0.02, p_ph_floor=0.02, ped_Ki=0.002, thal_decay=1.0e-4,   # ped_Ki unused for WT (no pediocin)
               p_decay=(0.0045, 0.0085), salt=0.3, adi_k=0.1),
    "mut": dict(ph_floor=0.05, p_ph_floor=0.10, ped_Ki=0.2, thal_decay=5.0e-5,
                p_decay=(0.0005, 0.0012), salt=0.7, adi_k=0.0),     # arcA knockout
}

def temperature(day):
    if day <= YEAST_DAY:
        return T_START
    return T_START + (T_END - T_START) * (day - YEAST_DAY) / (TOTAL_DAYS - YEAST_DAY)

def cold_fraction(T):
    return min(1.0, max(0.0, (T_START - T) / (T_START - T_END)))

def lerp(pair, c):
    return pair[0] + (pair[1] - pair[0]) * c

def ph_factor(pH, floor, stop, free=PH_FREE):
    return 1.0 if pH > free else max(floor, (pH - stop) / (free - stop))

def ped_gate(pH):
    if not PED_GATE_ON or pH <= PED_PH_FULL:
        return 1.0
    if pH >= PED_PH_OFF:
        return PED_GATE_FLOOR
    return 1.0 - (1.0 - PED_GATE_FLOOR) * (pH - PED_PH_FULL) / (PED_PH_OFF - PED_PH_FULL)

# =====================================================================
# MODEL BUILDING
# =====================================================================
def add_reaction(m, rid, stoich, bounds=(0.0, 1000.0)):
    comp_c, comp_e = m.metabolites.h_c.compartment, m.metabolites.h_e.compartment
    r = Reaction(rid); r.bounds = bounds
    mets = {}
    for mid, coef in stoich.items():
        if mid not in m.metabolites:
            m.add_metabolites(Metabolite(mid, compartment=comp_e if mid.endswith("_e") else comp_c))
        mets[m.metabolites.get_by_id(mid)] = coef
    r.add_metabolites(mets); m.add_reactions([r])

def force_demand(m, met_id, frac):
    dm = m.add_boundary(m.metabolites.get_by_id(met_id), type="demand")
    m.add_cons_vars(m.problem.Constraint(
        dm.flux_expression + frac * m.reactions.EX_glc__D_e.flux_expression, lb=0))

def build_thal(frac_gsh):
    m = cobra.io.read_sbml_model("thal_ready.xml")
    if frac_gsh > 0:                       # gshAB overexpression
        if "GLUCYS" not in m.reactions:
            add_reaction(m, "GLUCYS", {"atp_c": -1, "cys__L_c": -1, "glu__L_c": -1,
                                       "adp_c": 1, "glucys_c": 1, "h_c": 1, "pi_c": 1})
        if "GTHS" not in m.reactions:
            add_reaction(m, "GTHS", {"atp_c": -1, "glucys_c": -1, "gly_c": -1,
                                     "adp_c": 1, "gthrd_c": 1, "h_c": 1, "pi_c": 1})
        force_demand(m, "gthrd_c", frac_gsh)
    return m

def build_pedio(frac_ped, adi_ko):
    m = cobra.io.read_sbml_model("pedio_ready2.xml")
    if adi_ko:
        m.reactions.ARGDI_1.bounds = (0.0, 0.0)            # arcA knockout
    if frac_ped > 0:                                       # heterologous pedABCD, engineered strain only
        aa = {"lys__L_c": 4, "tyr__L_c": 2, "gly_c": 8, "asn__L_c": 4, "val__L_c": 2, "thr__L_c": 4,
              "cys__L_c": 4, "his__L_c": 3, "ser__L_c": 2, "asp__L_c": 1, "trp__L_c": 2, "ala__L_c": 4,
              "ile__L_c": 2, "met__L_c": 1, "gln__L_c": 1}
        atp = 172 + PED_LEADER_ATP + PED_EXPORT_ATP
        st = {k: -v for k, v in aa.items()}
        st.update({"atp_c": -atp, "h2o_c": -129, "adp_c": atp, "pi_c": atp, "h_c": atp, "pedioc_c": 1})
        add_reaction(m, "PEDIOCIN_SYN", st)
        force_demand(m, "pedioc_c", frac_ped)
    return m

_BUILDERS = {
    "thal_wt":   lambda: build_thal(0.0),
    "pedio_wt":  lambda: build_pedio(FRAC_PED["wt"], adi_ko=False),
    "pedio_mut": lambda: build_pedio(FRAC_PED["mut"], adi_ko=True),
}
_models = {}

def get_model(key):
    """Models are built on demand (thal_mut models: one per FRAC_GSH value, key 'thal_mut@0.006')."""
    if key not in _models:
        if key in _BUILDERS:
            _models[key] = _BUILDERS[key]()
        else:
            base, _, arg = key.partition("@")
            if base == "thal_mut":
                _models[key] = build_thal(float(arg))
            else:
                raise KeyError(key)
    return _models[key]

_cache = {}

def fba(key, q):
    """(mu, glucose flux, lactate, acetate, extra) at uptake q (mmol/gDW/h).
    extra = glutathione flux (thal) or pediocin flux (pedio).
    mu is the step-2 growth (held at >= 95% of maximum while lactate is maximised)."""
    q = round(q, 3)
    if q < 1e-3:
        return (0.0,) * 5
    if (key, q) in _cache:
        return _cache[(key, q)]
    m = get_model(key)
    strain = key.split("_")[0]
    lacs = ["EX_lac__L_e"] + (["EX_lac__D_e"] if strain == "pedio" else [])
    extra = "DM_gthrd_c" if strain == "thal" else "DM_pedioc_c"
    res = (0.0,) * 5
    with m:
        m.reactions.EX_glc__D_e.lower_bound = -q
        m.reactions.ATPM.lower_bound = 0.5 * q
        mu = m.slim_optimize(error_value=float("nan"))
        if mu == mu and mu > 1e-9:
            m.reactions.Growth.lower_bound = 0.95 * mu
            m.objective = {m.reactions.get_by_id(e): 1.0 for e in lacs}
            sol = m.optimize()
            if sol.status == "optimal":
                f = sol.fluxes
                res = (f["Growth"], abs(f["EX_glc__D_e"]), sum(f[e] for e in lacs),
                       max(0.0, f["EX_ac_e"]), f.get(extra, 0.0))
        else:
            print(f"  FBA infeasible: {key} q={q}")
    _cache[(key, q)] = res
    return res

def sanity():
    print("Model sanity checks (q=1.0):")
    for key, m in list(_models.items()):
        mu, glc, lac, ac, ex = fba(key, 1.0)
        with m:
            m.reactions.EX_glc__D_e.lower_bound = 0
            m.reactions.ATPM.lower_bound = 0
            g0 = m.slim_optimize(error_value=float("nan"))
        print(f"  {key:20s} mu={mu:.5f} lactate/glc={lac:.2f} extra flux={ex:.5f} no-glucose mu={g0:.2e}")

# =====================================================================
# SIMULATION
# =====================================================================
def simulate(v, frac_gsh=None, wv_std=None):
    P = PARAMS[v]
    if v == "mut":
        frac_gsh = FRAC_GSH_SET["base"] if frac_gsh is None else frac_gsh
        tk, wv_day = f"thal_mut@{frac_gsh}", LAB_DAY
    else:
        tk = "thal_wt"
        wv_day = WV_STD_SET["base"] if wv_std is None else wv_std
    pk = f"pedio_{v}"

    x1 = x2 = xy = xw = 0.0
    thal_in = pedio_in = yeast_in = wv_in = False
    wv_start = None
    glc, starch, lac, ped = 12.0, 320.0, 0.0, 0.0
    lac_t_tot = lac_p_tot = 0.0
    arg, citr, nh3 = ARG0_mM, 0.0, 0.0
    fa, vg, eg = FA0_mg, 0.0, 0.0
    gthal = gsh = 0.0
    ph5_day = None
    H = {k: [] for k in ("day", "T", "x1", "x2", "xy", "xw", "pH", "ped", "citr", "glc", "lac",
                         "gthal", "gsh", "smoky", "vg", "eg")}

    for step in range(int(TOTAL_DAYS * 24 / DT)):
        day = step * DT / 24.0
        T = temperature(day)
        c = cold_fraction(T)

        if not thal_in and day >= LAB_DAY:
            x1, thal_in = INOC_THAL, True
        if not pedio_in and day >= PEDIO_DAY:
            x2, pedio_in = INOC_PEDIO, True
        if not yeast_in and day >= YEAST_DAY:
            xy, yeast_in = INOC_YEAST, True
        if not wv_in and day >= wv_day:
            xw, wv_in, wv_start = INOC_WV, True, day

        # pH (lactate-equivalent acid minus ADI ammonia)
        acid_M = max(0.0, lac / 90.08 - nh3 / 1000.0)
        if acid_M < 0.038:
            pH = 6.5 - 1.6 * (acid_M / 0.038) ** 1.8
        else:
            pH = 4.9 - 0.4 * np.log10(1.0 + 20.0 * (acid_M - 0.038))
        pH = max(3.5, pH)
        if pH <= 5.0 and ph5_day is None:
            ph5_day = day

        # amylase
        amy_ph   = min(1.0, max(0.05, (pH - AMY_PH_STOP) / (AMY_PH_FREE - AMY_PH_STOP)))
        amy_salt = AMY_SALT if day >= SALT_DAY else 1.0
        rel = lerp(T_AMYLASE, c) * amy_ph * amy_salt
        rel = rel * starch / (starch + 40.0) * DT if starch > 0.1 else 0.0
        glc += rel; starch -= rel

        # kinetic limits on glucose uptake
        kin = glc / (glc + 1.2) if glc > 0.01 else 0.0
        ph_inh_t = ph_factor(pH, P["ph_floor"],   PH_STOP_THAL)
        ph_inh_p = ph_factor(pH, P["p_ph_floor"], PH_STOP_PEDIO)
        ped_f = 1.0 / (1.0 + ped / P["ped_Ki"])
        salt_f = P["salt"] if day >= SALT_DAY else 1.0
        on = glc > 0.01
        q_t = Q_THAL  * lerp(T_THAL_MU,  c) * kin * ph_inh_t * ped_f       if (x1 > 0 and on) else 0.0
        q_p = Q_PEDIO * lerp(T_PEDIO_MU, c) * kin * salt_f * ph_inh_p      if (x2 > 0 and on) else 0.0
        mu_t, glc_t, lac_t, ac_t, gsh_t = fba(tk, q_t)
        mu_p, glc_p, lac_p, ac_p, ped_p = fba(pk, q_p)
        if v == "mut":
            mu_p *= (1.0)                                       

        # Z. rouxii (kinetic only)
        mu_y = 0.022 * glc / (glc + 2.5) * max(0.0, 1 - xy / 3.5) if (xy > 0 and on) else 0.0
        glc_y = (mu_y / 0.28) / G_GLC

        # W. versatilis: glucose, pH and salt limited
        ph_w   = ph_factor(pH, 0.0, WV_PH_STOP, WV_PH_FREE)
        salt_w = WV_SALT if day >= SALT_DAY else 1.0
        mu_w = (MU_WV * glc / (glc + KS_WV) * ph_w * salt_w * max(0.0, 1 - xw / XMAX_WV)
                if (xw > 0 and on) else 0.0)
        glc_w = (mu_w / Y_WV) / G_GLC

        # glucose balance (mmol/L)
        d_t, d_p = glc_t * x1 * DT, glc_p * x2 * DT
        d_y, d_w = glc_y * xy * DT, glc_w * xw * DT
        total = d_t + d_p + d_y + d_w
        f = min(1.0, (glc / G_GLC) / total) if total > 0 else 1.0
        glc = max(0.0, glc - total * f * G_GLC)

        # products
        dl_t = (lac_t + ac_t) * x1 * DT * f * G_ACID
        dl_p = (lac_p + ac_p) * x2 * DT * f * G_ACID
        lac += dl_t + dl_p
        lac_t_tot += dl_t; lac_p_tot += dl_p
        degr = lerp(T_PED_DEGR, c)
        ped = max(0.0, ped + ped_p * ped_gate(pH) * x2 * DT * f * G_PED - degr * ped * DT)
        gthal += glc_t * x1 * DT * f * G_GLC                       # g/L glucose used by thal
        gsh   += gsh_t * x1 * DT * f * G_GSH                       # g/L glutathione (FBA flux)

        # ADI (arginine -> citrulline + NH3), repressed by glucose
        if x2 > 0 and P["adi_k"] > 0:
            r = P["adi_k"] * arg / (arg + 2.0) / (1.0 + glc / 5.0) * x2 * DT
            r = min(r, arg); arg -= r; citr += r; nh3 += r

        # biomass
        p_dec = lerp(P["p_decay"], c)
        if x1 > 0:
            x1 = max(0.001, x1 + (mu_t * f * max(0.0, 1 - x1 / 7.3) - P["thal_decay"]) * x1 * DT)
        if x2 > 0:
            x2 = max(0.0, x2 + (mu_p * f * max(0.0, 1 - x2 / 0.5) - p_dec) * x2 * DT)
        if xy > 0:
            xy = max(0.0, xy + (mu_y * f - 0.0002) * xy * DT)
        if xw > 0:
            xw = max(0.0, xw + (mu_w * f - DECAY_WV) * xw * DT)

        # smoky: ferulic acid -> 4-VG -> 4-EG by W. versatilis biomass (mg/L)
        if xw > 0:
            r1 = min(fa, K_PAD * fa / (fa + 10.0) * xw * DT)
            pool = vg + r1
            r2 = min(pool, K_VPR * pool / (pool + 5.0) * xw * DT)
            fa -= r1; vg = pool - r2; eg += r2
        smoky = vg + eg

        for val in (glc, x1, x2, xy, xw, lac, ped, fa, vg, eg):
            assert np.isfinite(val), f"non-finite state, {v}, day {day:.1f}"

        for k, val in (("day", day), ("T", T), ("x1", x1), ("x2", x2), ("xy", xy), ("xw", xw),
                       ("pH", pH), ("ped", ped * 1000), ("citr", citr * MW_CITR), ("glc", glc),
                       ("lac", lac), ("gthal", gthal), ("gsh", gsh),
                       ("smoky", smoky), ("vg", vg), ("eg", eg)):
            H[k].append(val)
    H.update(ph5_day=ph5_day, wv_day=wv_start, starch_left=starch, fa_left=fa,
             acid_thal=lac_t_tot, acid_pedio=lac_p_tot)
    return H

def flavour(H, v, umami_fold=1.0):
    """Umami, kokumi, meaty indices from stored thal glucose use and glutathione (g/L, assumed multipliers)."""
    g = np.array(H["gthal"])
    um = MULT_WT["umami"] * (umami_fold if v == "mut" else 1.0) * g
    ko = MULT_WT["kokumi"] * g + np.array(H["gsh"])
    me = MULT_WT["meaty"] * (MEATY_FOLD if v == "mut" else 1.0) * g
    return um, ko, me

FRAC_GSH_SET = {}

if __name__ == "__main__":
    # =====================================================================
    # RUNS: WT first (to calibrate the multipliers), then the engineered runs
    # =====================================================================
    runs_wt = {k: simulate("wt", wv_std=d) for k, d in WV_STD_SET.items()}
    G = runs_wt["base"]["gthal"][-1]                  # g/L glucose consumed by WT T. halophilus

    MULT_WT["umami"]  = ATTR["umami"]  * TYPICAL["umami"]  / G
    MULT_WT["kokumi"] = ATTR["kokumi"] * TYPICAL["kokumi"] / G
    FRAC_GSH_SET = {k: (f - 1.0) * MULT_WT["kokumi"] * G_GLC / G_GSH for k, f in KOKUMI_FOLDS.items()}
    frac_txt = {k: float(f"{v:.2e}") for k, v in FRAC_GSH_SET.items()}
    print(f"Glucose used by WT T. halophilus: {G:.1f} g/L | WT multipliers: umami={MULT_WT['umami']:.4f}, "
          f"kokumi={MULT_WT['kokumi']:.2e} | FRAC_GSH={frac_txt}")

    runs_mut = {k: simulate("mut", frac_gsh=f) for k, f in FRAC_GSH_SET.items()}
    sanity()

    WT, MUT = runs_wt["base"], runs_mut["base"]

    # ---- indices relative to WT final (WT = 1) ----
    um_wt, ko_wt, me_wt = flavour(WT, "wt")
    um_mut = {k: flavour(MUT, "mut", umami_fold=f)[0] for k, f in UMAMI_FOLDS.items()}
    ko_runs = {k: flavour(H, "mut")[1] for k, H in runs_mut.items()}
    ko_mean = np.mean(list(ko_runs.values()), axis=0)             # mean over FRAC_GSH runs
    me_mut = flavour(MUT, "mut")[2]
    sm_mut = np.array(MUT["smoky"])
    sm_wt  = {k: np.array(H["smoky"]) for k, H in runs_wt.items()}

    def fin(a):
        return max(float(a[-1]), 1e-12)

    print(f"\nSummary ({MOROMI_DAYS:.0f} d moromi, 10% NaCl)")
    for label, H in (("WT (W. versatilis at standard day)", WT), ("Engineered (base FRAC_GSH)", MUT)):
        wvd = H["wv_day"]
        print(f"  {label}: pH={H['pH'][-1]:.2f} lactate={H['lac'][-1]:.1f} g/L "
              f"(thal {H['acid_thal']:.1f}, pedio {H['acid_pedio']:.2f}) | pH5 day={H['ph5_day']} | "
              f"W.versatilis start={'none' if wvd is None else round(wvd, 1)} d, final {H['xw'][-1]:.2f} g/L | "
              f"4-EG={H['eg'][-1]:.1f} 4-VG={H['vg'][-1]:.1f} mg/L, ferulic acid left={H['fa_left']:.1f} mg/L | "
              f"peak pediocin={max(H['ped']):.1f} mg/L")
    print("\nIndices at the end, relative to WT final = 1:")
    print("  umami  :", {k: round(float(um_mut[k][-1] / fin(um_wt)), 2) for k in UMAMI_FOLDS})
    print("  kokumi :", {f"FRAC_GSH={FRAC_GSH_SET[k]:.2e}": round(float(a[-1] / fin(ko_wt)), 2) for k, a in ko_runs.items()},
          "| mean =", round(float(ko_mean[-1] / fin(ko_wt)), 2))
    print("  meaty  :", round(float(me_mut[-1] / fin(me_wt)), 2), "(assumed fold)")
    print("  smoky  :", {f"WT std day {WV_STD_SET[k]:.0f}": round(float(sm_mut[-1] / fin(a)), 2) for k, a in sm_wt.items()})

    # =====================================================================
    # PLOTS: day 0 = T. halophilus inoculation
    # =====================================================================
    t0 = LAB_DAY
    d = np.array(MUT["day"]) - t0
    msk = d >= 0
    dd = d[msk]
    nr = lambda a, ref: (np.asarray(a) / fin(ref))[msk]

    fig, ax = plt.subplots(2, 2, figsize=(15, 10)); ax = ax.flatten()
    sty = {"wt": dict(ls="--", lw=1.4), "mut": dict(ls="-", lw=2.4)}

    # 1. biomass (WT and engineered, base runs; Z. rouxii once)
    for v, H in (("wt", WT), ("mut", MUT)):
        ax[0].plot(dd, np.array(H["x1"])[msk], color="green",  label=f"T. halophilus {v}",   **sty[v])
        ax[0].plot(dd, np.array(H["x2"])[msk], color="purple", label=f"P. acidilactici {v}", **sty[v])
    ax[0].plot(dd, np.array(MUT["xy"])[msk], color="tab:blue", lw=2.0, label="Z. rouxii (unmodified)")

    # 2. flavour indices relative to WT final (WT = 1): base lines + shaded low-high ranges
    smoky_ref = sm_wt["base"]
    um_base = nr(um_mut["base"], um_wt)
    um_a, um_b = nr(um_mut["low"], um_wt), nr(um_mut["high"], um_wt)
    ko_base = nr(ko_runs["base"], ko_wt)
    ko_a, ko_b = nr(ko_runs["low"], ko_wt), nr(ko_runs["high"], ko_wt)
    um_lo, um_hi = np.minimum(um_a, um_b), np.maximum(um_a, um_b)
    ko_lo, ko_hi = np.minimum(ko_a, ko_b), np.maximum(ko_a, ko_b)

    # umami range, drawn in full (narrower band)
    ax[1].fill_between(dd, um_lo, um_hi, color="orange", alpha=0.30, lw=0, label="umami range")

    # kokumi range, only the parts outside the umami range
    up_lo = np.maximum(um_hi, ko_lo); up_hi = np.maximum(ko_hi, up_lo)      # above umami
    dn_hi = np.minimum(um_lo, ko_hi); dn_lo = np.minimum(ko_lo, dn_hi)      # below umami
    ax[1].fill_between(dd, up_lo, up_hi, color="chocolate", alpha=0.30, lw=0, label="kokumi range (beyond umami)")
    ax[1].fill_between(dd, dn_lo, dn_hi, color="chocolate", alpha=0.30, lw=0)

    # lines on top
    ax[1].plot(dd, nr(um_wt, um_wt), color="orange", ls="--", lw=1.4, label="umami WT", zorder=3)
    ax[1].plot(dd, um_base, color="orange", lw=2.4, label="umami engineered (base)", zorder=3)
    ax[1].plot(dd, nr(ko_wt, ko_wt), color="chocolate", ls="--", lw=1.4, label="kokumi WT", zorder=3)
    ax[1].plot(dd, ko_base, color="chocolate", lw=2.4, label="kokumi engineered (base)", zorder=3)
    ax[1].plot(dd, nr(me_wt, me_wt), color="red", ls="--", lw=1.4, label="meaty WT", zorder=3)
    ax[1].plot(dd, nr(me_mut, me_wt), color="red", lw=2.4, label="meaty engineered", zorder=3)
    ax[1].plot(dd, nr(smoky_ref, smoky_ref), color="dimgray", ls="--", lw=1.4, label="smoky WT", zorder=3)
    ax[1].plot(dd, nr(sm_mut, smoky_ref), color="dimgray", lw=2.4, label="smoky engineered", zorder=3)

    tops = [um_hi.max(), ko_hi.max(), nr(me_mut, me_wt).max(), nr(sm_mut, smoky_ref).max(), 1.0]
    ax[1].set_ylabel("Index relative to WT")
    ax[1].set_ylim(0, 1.1 * max(tops))

    # 3. pH (engineered process)
    ax[2].plot(dd, np.array(MUT["pH"])[msk], color="red", lw=2.4, label="pH")
    ax[2].set_ylim(4.2, 6.7); ax[2].set_ylabel("pH")
    axT = ax[2].twinx()
    axT.plot(dd, np.array(MUT["T"])[msk], color="gray", lw=1.2, label="Temperature (C)")
    axT.set_ylabel("Temperature (C)"); axT.set_ylim(20, 35); axT.legend(loc="lower right", fontsize=7)

    # 4. pediocin
    for v, H in (("wt", WT), ("mut", MUT)):
        ax[3].plot(dd, np.array(H["ped"])[msk], color="magenta",
                   label="pediocin WT (ATCC 8042, none)" if v == "wt" else "pediocin engineered (pedABCD)", **sty[v])

    titles = ["Biomass (g/L)", "Flavor indices relative to WT", "Broth pH", "Pediocin (mg/L)"]
    markers = [(0.0, "maroon"), (PEDIO_DAY - t0, "purple"), (YEAST_DAY - t0, "tab:blue")]
    for a, t in zip(ax, titles):
        a.set_title(t, fontweight="bold")
        a.set_xlabel("Days after T. halophilus inoculation")
        a.set_xlim(0, TOTAL_DAYS - t0)
        a.grid(True, ls=":", alpha=0.6)
        for x, col in markers:
            a.axvline(x, color=col, ls=":", lw=1.2)
        a.legend(fontsize=7, ncol=2)

    plt.suptitle("10% NaCl Moromi model")
    plt.tight_layout()
    plt.savefig("moromi_wt_vs_mut_45_2.png", dpi=300, bbox_inches="tight")
    plt.show()
